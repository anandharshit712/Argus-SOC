# Backend API settings (Workstream C). Add these lines to the repo-root .env, next to the
# shared settings from the root .env.example (ARGUS_TENANTS, ARGUS_GRAPH_BACKEND, FALKORDB_*,
# API_PORT, API_CORS_ORIGINS). Never commit real values.

# Hard-coded demo users for the hackathon (HLD D13). JSON on one line. Every tenant must be in
# ARGUS_TENANTS. Pick your own passwords; these placeholders are not meant to be used.
ARGUS_DEMO_USERS=[{"username":"acme.analyst","display_name":"Acme Analyst","password":"change-me-acme","tenants":["acme"]},{"username":"globex.analyst","display_name":"Globex Analyst","password":"change-me-globex","tenants":["globex"]},{"username":"demo.admin","display_name":"Demo Admin","password":"change-me-admin","tenants":["acme","globex"]}]

# Signs the session tokens (HMAC). At least 32 random characters; changing it signs everyone out.
# For example: python -c "import secrets; print(secrets.token_urlsafe(48))"
ARGUS_SESSION_SECRET=

# How long a sign-in lasts.
ARGUS_SESSION_HOURS=12
