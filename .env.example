# Copy to .env and fill in. Never commit .env. Every variable is listed in docs/LLD.md §2;
# each workstream adds its own section here with safe defaults and no real secrets.

# --- Workstream B: database and graph ---------------------------------------
# Inside Docker Compose the database is reached by service name: FALKORDB_HOST=falkordb.
# Running Python on your own machine against the Compose database: FALKORDB_HOST=127.0.0.1
# (not "localhost": on Windows that tries IPv6 first and each connection waits ~2 s).
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
# Tenants that may have a graph (tenant id -> graph tenant_<id>).
ARGUS_TENANTS=acme,globex
# Graph backend: "falkordb" (real database) or "stub" (fixed sample data, no database).
ARGUS_GRAPH_BACKEND=falkordb
# How the agents start the graph MCP server (stdio subprocess).
MCP_SERVER_COMMAND=python -m argus_soc.graph.mcp_server

# --- Docker Compose (Workstream B) ---------------------------------------------
# Containers always use FALKORDB_HOST=falkordb and TALOS_URL=http://talos:8000 (set in
# docker-compose.yml); the values above are for Python run on your own machine.
# Password of Talos's PostgreSQL. Pick any long random value; never commit it.
TALOS_DB_PASSWORD=change-me
# Cloud VM only (GCP): the public host name with an HTTPS certificate (deploy/gcp_runbook.md).
ARGUS_DOMAIN=
# Cloud VM only: public host name of the demo web shop (docker-compose.public-shop.yml); the
# certificate for ARGUS_DOMAIN must cover it too.
SHOP_DOMAIN=

# --- Workstream A: ingestor and agents ---------------------------------------
# One shared Talos; each report goes to the tenant whose inventory has its host.
# One Talos per tenant instead: set TALOS_URL_<TENANT>, e.g. TALOS_URL_ACME=http://talos-acme:8000
TALOS_URL=http://talos:8000
INGEST_POLL_SECONDS=3
INGEST_PAGE_LIMIT=50
# Where tenant_<tenant>_inventory.yaml files are read from (routing reports, own IPs).
ARGUS_INVENTORY_DIR=data/inventory
# LLM (optional): explanations and the Investigator's deep dive. Off or unset = templates,
# and every decision is still made (decisions never depend on the LLM).
LLM_ENABLED=false
# Your Anthropic (sk-ant-...) or OpenAI (sk-...) key. Never commit a real key.
LLM_API_KEY=
# anthropic | openai. Empty: read from the key (sk-ant- = anthropic, else openai).
# Exact spelling: any other value (e.g. open-ai) silently turns the LLM off.
LLM_PROVIDER=
# Empty on Anthropic = claude-opus-5-5. Required on OpenAI (a model your account can use).
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
DEEP_DIVE_ENABLED=true
DEEP_DIVE_MAX_CALLS=4

# --- Everyone ----------------------------------------------------------------
LOG_LEVEL=INFO

# --- Live demo harness (demo/, Workstream A) ---------------------------------
# All synthetic: dummy creds for the throwaway demo targets only, never real secrets.
# The shop's one valid login (every other attempt fails, as the brute-force demo needs).
DEMO_VALID_ACCOUNT=demo@shop.example
DEMO_VALID_PASSWORD=correct-horse-battery-staple
# The ssh_target's dummy account password (set at image build via SSH_TARGET_PASSWORD).
SSH_TARGET_PASSWORD=correct-horse-battery-staple-ssh
# 1 = attack-bot runs the always-on weighted-random chaos loop at boot; 0 = on-demand only
# (toggle at runtime with POST /soak/start and /soak/stop either way).
DEMO_SOAK=0

# --- Attack-bot pass/fail v2 (ATTACK_BOT_PASS_FAIL_DESIGN.md) -----------------
# Soak runs now fail OR pass; a pass is a real success Talos marks `succeeded` and Argus opens a
# case for. Exactly round(bag_size * ratio) of every bag pass (default 3 in every 10).
DEMO_PASS_RATIO=0.3
DEMO_BAG_SIZE=10
DEMO_SOAK_INTERVAL_MIN=45
DEMO_SOAK_INTERVAL_MAX=180
# REQUIRED for passes to work: the shared password for the web pool accounts (pool####@shop.example)
# and the SSH pool accounts (ops###). All synthetic; set to any long random values. If either is
# left empty the bot still runs but skips that campaign's passes, with a reason in /selfcheck.
DEMO_POOL_PASSWORD=
DEMO_WEB_POOL_SIZE=500
DEMO_SSH_POOL_PASSWORD=
DEMO_SSH_POOL_SIZE=300
# Backlog pause: soak pauses while more than this many Cases are Awaiting approval (0 = off).
DEMO_MAX_PENDING=20
# Which tenant graph the backlog count reads (tenant_<id>). Every live attack lands in Globex
# (the shop is gx-web-01, the SSH target gx-jump-01), so this stays globex.
DEMO_TENANT=globex
# Optional: the Argus UI address the shop page links to ("see the case in Argus").
DEMO_ARGUS_UI_URL=
